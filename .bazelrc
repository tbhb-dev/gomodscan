# Generated by `bazel run //:preset.update`; the content follows the Bazel
# version, so it is regenerated whenever .bazelversion moves. It comes first
# so the flags below can override it.
import %workspace%/preset.bazelrc

# aspect_tools_telemetry, which aspect_rules_js brings in, reports the Bazel
# and module versions in use unless told not to.
common --repo_env=DO_NOT_TRACK=1

common --lockfile_mode=error

# Fail when a bazel_dep version is lower than what the module graph resolves
# to, so the declared minimums stay honest.
common --check_direct_dependencies=error

build:release -c opt --stamp --workspace_status_command=tools/get_workspace_status.sh
# Bazel runs the status command without a shell on Windows, so Windows
# release builds use the batch form.
build:release-windows --config=release --workspace_status_command=tools/get_workspace_status.bat
# `common:windows` lines apply on Windows only (preset.bazelrc sets this
# too; it is stated here so the lines below never depend on the preset).
common --enable_platform_specific_config

# Runfiles trees on Windows too, as on macOS and Linux: the tree checks and
# the test scripts find their tools and data through them.
common:windows --enable_runfiles

# Real symlinks in runfiles trees on Windows. Without them Bazel copies the
# files, and the copies go stale between builds.
startup --windows_enable_symlinks

try-import %workspace%/.bazelrc.user
