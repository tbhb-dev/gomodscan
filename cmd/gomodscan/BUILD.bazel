load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "gomodscan_lib",
    srcs = ["main.go"],
    importpath = "go.tbhb.dev/gomodscan/cmd/gomodscan",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/buildmeta",
        "//internal/cachehttp",
        "//internal/exitcode",
        "//internal/findings",
        "//internal/osv",
        "//internal/pkgsite",
        "//internal/retryhttp",
        "//internal/vendormod",
    ],
)

go_binary(
    name = "gomodscan",
    embed = [":gomodscan_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "gomodscan_test",
    srcs = [
        "filemode_unix_test.go",
        "main_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":gomodscan_lib"],
    visibility = ["//:__pkg__"],
    deps = [
        "//internal/buildmeta",
        "//internal/cachehttp",
        "//internal/exitcode",
        "//internal/findings",
        "//internal/osv",
        "//internal/pkgsite",
        "//internal/retryhttp",
        "//internal/vendormod",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
    # The whole-module Go checks in the root package take the tests too.
)

# The fixtures also go to the condition-coverage target in the root package.
filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//:__pkg__"],
)
