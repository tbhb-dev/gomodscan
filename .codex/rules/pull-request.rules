# Agents open, edit and merge pull requests through the interim PR scripts
# (`mise run pr`, `mise run merge`), never with gh directly. The scripts call
# gh themselves; these rules only see commands the agent types. They back up
# tools/interim/guard_gh_pr.py, the PreToolUse hook that blocks the same calls
# and hints at the right command; the rule catches what the hook misses.
prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "merge"]],
    decision = "forbidden",
    justification = "Blocked: do not run gh pr create|edit|merge. Write .github/PULL_REQUEST_DRAFT.md, then `mise run pr -- check` and `mise run pr -- create`, or `mise run pr -- edit --pr N` to update; `mise run merge -- N` squash-merges an approved PR.",
)
