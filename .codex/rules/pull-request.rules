# Agents open, edit and merge pull requests through `tbhbdev alpha pr` and
# `tbhbdev alpha merge`, never with gh directly. The commands call gh
# themselves; these rules only see commands the agent types. They back up
# the `tbhbdev alpha` PreToolUse hook that blocks the same calls and hints at
# the right command; the rule catches what the hook misses.
prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "merge"]],
    decision = "forbidden",
    justification = "Blocked: do not run gh pr create|edit|merge. Write .github/PULL_REQUEST_DRAFT.md, then `tbhbdev alpha pr check` and `tbhbdev alpha pr create`, or `tbhbdev alpha pr edit --pr N` to update; `tbhbdev alpha merge N` squash-merges an approved PR.",
)
