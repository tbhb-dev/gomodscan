load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "retryhttp",
    srcs = ["retryhttp.go"],
    importpath = "go.tbhb.dev/gomodscan/internal/retryhttp",
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_failsafe_go_failsafe_go//failsafehttp",
        "@com_github_failsafe_go_failsafe_go//timeout",
    ],
)

go_test(
    name = "retryhttp_test",
    srcs = ["retryhttp_test.go"],
    visibility = ["//:__pkg__"],
    deps = [
        ":retryhttp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
    # The whole-module Go checks in the root package take the tests too.
)
