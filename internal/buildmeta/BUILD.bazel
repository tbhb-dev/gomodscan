load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "buildmeta",
    srcs = ["buildmeta.go"],
    importpath = "go.tbhb.dev/gomodscan/internal/buildmeta",
    visibility = ["//:__subpackages__"],
    x_defs = {
        "Commit": "{STABLE_BUILD_SCM_REVISION}",  # keep
        "Date": "{STABLE_BUILD_SCM_DATE}",  # keep
        "Version": "{STABLE_BUILD_SCM_VERSION}",  # keep
    },
)

go_test(
    name = "buildmeta_test",
    srcs = [
        "buildmeta_internal_test.go",
        "buildmeta_test.go",
    ],
    embed = [":buildmeta"],
    visibility = ["//:__pkg__"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
    # The whole-module Go checks in the root package take the tests too.
)
