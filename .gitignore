# Local development
tmp/
.env
.env.*
!.env.example
mise.local.toml

# Agent drafts. Authored at the repo root so vale's [formats] mapping
# resolves them, linted via `mise run lint-commit-msg` and its siblings,
# then consumed by the commit and pull request skills. Never committed.
COMMIT_AGENTMSG
PR_AGENTDESC.md
SQUASH_AGENTMSG
.fix-prose/

# Go build output
bin/
/gomodscan
coverage.out
coverage.html
coverage.txt
coverage.xml
coverage.covdata*/

# Test outputs
testdata/fuzz/

# Linter caches
.rumdl_cache/
node_modules/
.cspell-cache
__pycache__/

# goreleaser
dist/

# gremlins
.gremlins/
gremlins-report.json

# Claude Code
.claude/worktrees/
.claude/settings.local.json

# Vale synced packages (keep the vocabulary).
# Each negation needs the parent un-ignored first — git can't re-include
# a child whose ancestor directory stays excluded.
.vale/*
!.vale/project/
!.vale/config/
.vale/config/*
!.vale/config/vocabularies/
.vale/config/vocabularies/*
!.vale/config/vocabularies/project/

# macOS
.DS_Store

# APM dependencies
apm_modules/
