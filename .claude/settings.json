{
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" --quiet bash \"$CLAUDE_PROJECT_DIR/tools/interim/install.sh\""
          },
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.15' python \"$CLAUDE_PROJECT_DIR/tools/interim/agent_identity.py\" record claude"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.15' python \"$CLAUDE_PROJECT_DIR/tools/interim/agent_identity.py\" record claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.15' python \"$CLAUDE_PROJECT_DIR/tools/interim/agent_identity.py\" record claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.15' python \"$CLAUDE_PROJECT_DIR/tools/interim/guard_gh_pr.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.15' python \"$CLAUDE_PROJECT_DIR/tools/interim/agent_identity.py\" record claude"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet python -m tools.interim.pull_request hook claude"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python '>=3.15' python \"$CLAUDE_PROJECT_DIR/tools/interim/agent_identity.py\" record claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__awrel"
    ],
    "deny": [
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "awrel"
  ]
}
